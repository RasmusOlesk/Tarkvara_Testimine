@model TARge25Shop.Models.RealEstate.RealEstateCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>
        Update
    </h1>
}
else
{
    <h1>
        Create
    </h1>
}

<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="ModifiedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="Area" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Area" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Location" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Location" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="RoomNumber" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="RoomNumber" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="BuildingType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="BuildingType" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Files" class="control-label"></label>
        <input asp-for="Files" multiple type="file" class="form-control" />
    </div>

    <div>
        @foreach(var image in Model.Image)
        {
            <partial name="_Images" model="image" />
            <input asp-action="removeImage" asp-controller="realEstate" asp-route-imageId="@image.ImageId" 
                    type="submit" class="btn btn-danger" value="Remove Image" />
        }
    </div>

    <hr />
    <br />

    @if (Model.Id.HasValue)
    {
        <input asp-action="update" asp-controller="realEstate" type="submit" class="btn btn-success" value="Update" />
    }
    else
    {
        <input asp-action="create" asp-controller="realEstate" type="submit" class="btn btn-success" value="Create" />
    }

    <a asp-action="Index" asp-controller="realEstate" class="btn btn-secondary">Back to List</a>
</form>

